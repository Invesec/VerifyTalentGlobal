# Copy this file to .env and fill in your own values. Never commit .env.
FLASK_DEBUG=1
PORT=5000

# Leave empty locally: the app uses a local SQLite file.
# On Render, paste the PostgreSQL Internal Database URL here.
DATABASE_URL=

# Used from Milestone 2 onward
SESSION_SECRET=
# Email through Gmail: turn on 2-Step Verification, then create an App Password
# (Google Account > Security > 2-Step Verification > App passwords).
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Optional second provider
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
ADMIN_EMAIL=
# Optional: creates the first admin on startup if no admin exists. Use 12+ characters,
# then REMOVE this variable once you can log in.
ADMIN_INITIAL_PASSWORD=

# Shown publicly on the site (leave empty to hide)
COMPANY_EMAIL=
TELEGRAM_USERNAME=
